# ===========================================================================
# BACKEND — Variables de entorno  (recurso SEPARADO en Coolify)
# ===========================================================================
# Pega esto en:  Coolify → recurso "unistyles-backend" → Environment Variables.
# Marca como "Secret" (icono del candado) todo lo que diga  # secret.
#
# Las dos líneas DATABASE_URL y REDIS_URL son las MÁS importantes: conectan el
# backend a la base de datos y a Redis que ahora viven como recursos APARTE.
# Copia el host interno desde la pantalla de cada base de datos en Coolify
# (sección "Internal" / "Connection string").
# ===========================================================================

NODE_ENV=production
PORT=3000

# --- CONEXIÓN A LA BASE DE DATOS (recurso PostgreSQL separado) --------------
# Formato:  postgresql://unistyles:<DB_PASSWORD>@<HOST_INTERNO>:5432/unistyles_db
# <HOST_INTERNO> lo da Coolify en la pantalla del recurso PostgreSQL.
DATABASE_URL=postgresql://unistyles:REEMPLAZAR_DB_PASSWORD@REEMPLAZAR_HOST_POSTGRES:5432/unistyles_db   # secret

# --- CONEXIÓN A REDIS (recurso Redis separado) -----------------------------
# Copia la "Redis URL (internal)" que muestra Coolify en el recurso Redis.
REDIS_URL=redis://:REEMPLAZAR_REDIS_PASSWORD@REEMPLAZAR_HOST_REDIS:6379                                  # secret

# --- SEGURIDAD -------------------------------------------------------------
JWT_SECRET=REEMPLAZAR_JWT_SECRET          # secret (el mismo de tu gestor de contraseñas)
JWT_EXPIRES_IN=7d

# --- URLs PÚBLICAS ---------------------------------------------------------
FRONTEND_URL=https://unistylescuracao.com
DIRECTUS_URL=https://cms.unistylescuracao.com
SITE_URL=https://unistylescuracao.com

# --- WHATSAPP (opcional — se puede dejar vacío al principio) ----------------
WHATSAPP_NUMBER=+59996736285
WHATSAPP_ACCESS_TOKEN=                    # secret
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=                    # secret
WHATSAPP_APP_SECRET=                      # secret

# --- SENTOO (pagos — opcional al principio) --------------------------------
SENTOO_API_KEY=                           # secret
SENTOO_MERCHANT_ID=
SENTOO_SANDBOX=true                       # déjalo en true hasta probar pagos reales
