# ===========================================================================
# DIRECTUS — Variables de entorno  (recurso SEPARADO en Coolify)
# ===========================================================================
# Tipo de recurso en Coolify:  "Docker Image"  →  directus/directus:11
# Pega esto en:  recurso "unistyles-directus" → Environment Variables.
# Marca como "Secret" todo lo que diga  # secret.
#
# Directus comparte la MISMA base de datos que el backend (unistyles_db).
# Eso es necesario y correcto: NO acopla sus ciclos de vida — si Directus se
# cae, la base de datos (recurso aparte) sigue viva, y al revés.
# ===========================================================================

# --- CLAVES DE DIRECTUS (de tu gestor de contraseñas) ----------------------
KEY=REEMPLAZAR_DIRECTUS_KEY               # secret
SECRET=REEMPLAZAR_DIRECTUS_SECRET         # secret

# --- ADMIN (solo se usa en el PRIMER arranque para crear el admin) ----------
ADMIN_EMAIL=admin@unistylescuracao.com
ADMIN_PASSWORD=REEMPLAZAR_DIRECTUS_ADMIN_PASSWORD   # secret

# --- URL PÚBLICA -----------------------------------------------------------
PUBLIC_URL=https://cms.unistylescuracao.com

# --- CONEXIÓN A LA BASE DE DATOS (recurso PostgreSQL separado) --------------
# DB_HOST = el host interno que muestra Coolify en el recurso PostgreSQL
# (NO es "postgres" ni "localhost"; es el nombre/host interno del recurso).
DB_CLIENT=pg
DB_HOST=REEMPLAZAR_HOST_POSTGRES
DB_PORT=5432
DB_DATABASE=unistyles_db
DB_USER=unistyles
DB_PASSWORD=REEMPLAZAR_DB_PASSWORD        # secret

# --- CACHÉ EN REDIS (recurso Redis separado) -------------------------------
CACHE_ENABLED=true
CACHE_STORE=redis
REDIS=redis://:REEMPLAZAR_REDIS_PASSWORD@REEMPLAZAR_HOST_REDIS:6379   # secret

# --- CORS (permite que la tienda hable con Directus) -----------------------
CORS_ENABLED=true
CORS_ORIGIN=https://unistylescuracao.com
