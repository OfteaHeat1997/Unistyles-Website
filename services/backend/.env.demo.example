# Local demo backend env (docker-compose.local.yml). Copy to .env to use with `npm run dev`.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://unistyles:localdev@localhost:5433/unistyles_db
REDIS_URL=redis://:localdev@localhost:6380
JWT_SECRET=local-demo-jwt-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173
DIRECTUS_URL=http://localhost:8055
# mock = simulated online payments (demo). Remove in production and set SENTOO_* instead.
PAYMENTS_MODE=mock
